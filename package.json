{
  "name": "elitlig-araclar",
  "productName": "Elitlig Araclar",
  "version": "2.9.0",
  "description": "Elitlig Araçlar — Mac için bağımsız masaüstü uygulaması: Yayın Stüdyosu (kamera, ekran ve skorbordla YouTube/RTMP canlı yayın, gol klipleri), Mesajlar (üye mesajları dahil), Talepler, Yapılacaklar, Ajanda, Not Defteri, Projeler, Saha ve maç planlama, Ön Muhasebe, Tablolar, Rehber, Hesap Araçları ve Odak Sayacı.",
  "main": "app/main.js",
  "author": "Nuun Medya <nuunmedya@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite --config renderer/vite.config.mjs",
    "build": "vite build --config renderer/vite.config.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run --config renderer/vite.config.mjs && node --test app/test/*.test.js",
    "dist": "npm run build && npm run ffmpeg && electron-builder --mac dmg zip --universal --publish never",
    "ffmpeg": "node build/fetch-ffmpeg.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.elitlig.araclar",
    "productName": "Elitlig Araclar",
    "copyright": "© Elitlig",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/test/**",
      "renderer/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "Elitlig-Araclar-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/ffmpeg/${arch}",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "LICENSE.txt"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Yayın Stüdyosu'nda kamera görüntüsünü canlı yayına almak için kamera kullanılır.",
        "NSMicrophoneUsageDescription": "Elitlig ekip sohbetindeki sesli aramalar ve Yayın Stüdyosu'ndaki canlı yayın sesi için mikrofon kullanılır.",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "CFBundleDisplayName": "Elitlig Araçlar"
      }
    },
    "dmg": {
      "title": "Elitlig Araçlar",
      "artifactName": "Elitlig-Araclar-${version}.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "afterPack": "build/afterPack.js",
    "executableName": "Elitlig Araclar"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
