{
  "name": "elitlig-araclar",
  "productName": "Elitlig Araclar",
  "version": "2.18.2",
  "description": "Elitlig Araçlar — Mac ve Windows için bağımsız masaüstü uygulaması: Yayın Stüdyosu (kamera, ekran ve skorbordla YouTube/RTMP canlı yayın, gol klipleri), Mesajlar (üye mesajları dahil), Talepler, Yapılacaklar, Ajanda, Not Defteri, Projeler, Saha ve maç planlama, Ön Muhasebe, Tablolar, Rehber, Hesap Araçları ve Odak Sayacı.",
  "main": "app/main.js",
  "author": "Nuun Medya <nuunmedya@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite --config renderer/vite.config.mjs",
    "build": "vite build --config renderer/vite.config.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run --config renderer/vite.config.mjs && node --test app/test/*.test.js",
    "dist": "npm run build && npm run ffmpeg && electron-builder --mac dmg zip --universal --publish never",
    "ffmpeg": "node build/fetch-ffmpeg.js",
    "dist:win": "npm run build && npm run ffmpeg:win && electron-builder --win nsis zip --x64 --publish never",
    "ffmpeg:win": "node build/fetch-ffmpeg.js --platform win32"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "dockview": "4.13.1",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.elitlig.araclar",
    "productName": "Elitlig Araclar",
    "copyright": "© Elitlig",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/test/**",
      "renderer/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "Elitlig-Araclar-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/ffmpeg/${arch}",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "LICENSE.txt"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Yayın Stüdyosu'nda kamera görüntüsünü canlı yayına almak için kamera kullanılır.",
        "NSMicrophoneUsageDescription": "Elitlig ekip sohbetindeki sesli aramalar ve Yayın Stüdyosu'ndaki canlı yayın sesi için mikrofon kullanılır.",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "CFBundleDisplayName": "Elitlig Araçlar"
      }
    },
    "dmg": {
      "title": "Elitlig Araçlar",
      "artifactName": "Elitlig-Araclar-${version}.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Elitlig-Araclar-${version}-win-${arch}.${ext}",
      "legalTrademarks": "Elitlig",
      "extraResources": [
        {
          "from": "build/ffmpeg/win-x64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elitlig Araçlar",
      "uninstallDisplayName": "Elitlig Araçlar",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "multiLanguageInstaller": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Elitlig-Araclar-Setup-${version}.exe"
    },
    "afterPack": "build/afterPack.js",
    "executableName": "Elitlig Araclar"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
